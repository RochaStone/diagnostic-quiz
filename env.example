# Copy this file to .env.local for local runs. On Vercel, add the same names under
# Project > Settings > Environment Variables. Never paste real values into a chat or commit them.

# Where leads go: supabase | memory | file   (local default: memory)
LEAD_STORE=memory
# Your Supabase project address, like https://abcdefgh.supabase.co  (Project Settings > API)
SUPABASE_URL=
# The SECRET key from Supabase (older projects call it the service role key). Server only, never in the browser.
SUPABASE_SECRET_KEY=

# How emails go out: resend | console   (local default: console, which prints them in the terminal)
EMAIL_DRIVER=console
RESEND_API_KEY=
# Who the email is from. The domain must be verified in Resend. Example: Your Name <hello@yourdomain.com>
EMAIL_FROM=

# Your quiz address, exactly as people visit it, with no slash at the end. Example: https://quiz.yourdomain.com
SITE_ORIGIN=

# The key to your admin list. 32 characters or more. Make one with: npm run token
ADMIN_TOKEN=
